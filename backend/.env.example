# Backend Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/Hire-platform?retryWrites=true&w=majority

# Client URLs allowed for CORS and OAuth redirects (comma-separated for multiple origins)
# For local dev: http://localhost:5173
# For production: https://<your-app>.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# GitHub OAuth Configuration
# Register an OAuth app at https://github.com/settings/developers
# - For local dev callback URL: http://localhost:5000/api/auth/github/callback
# - For production callback URL: https://<your-backend-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
